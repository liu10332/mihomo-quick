[Unit]
Description=Mihomo (Clash.Meta) Proxy Service with TUN
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# 必须以 root 运行：创建 TUN 设备 (TUNSETIFF) 和 auto-route 改路由表需要
# CAP_NET_ADMIN。加 User={USER} 会让 mihomo 建网卡时报
# "Operation not permitted"，服务起不来（普通模式的 mihomo.service 才用 User=）。
#
# 不要预先 `ip tuntap add / addr / link`：设备由 mihomo 自己创建、进程退出即销毁，
# 这些命令带 `-` 前缀只会把失败藏起来，网卡其实从来没建出来。
#
# 不要设置 HTTP_PROXY / ALL_PROXY：ExecStartPre 的更新脚本会去连一个还没起来的
# 7890 端口，下载必然失败；mihomo 自身流量也不该先绕自己一圈。
ExecStartPre=-{BIN_DIR}/mihomo-auto-update
ExecStart={BIN_DIR}/mihomo-core -d {CONFIG_DIR}
ExecReload=/bin/kill -HUP $MAINPID

Restart=always
RestartSec=5
TimeoutStopSec=30
# ExecStartPre 的更新脚本自带 25s 硬预算，必须小于这里：
# `-` 前缀只忽略退出码，不忽略启动超时，脚本一旦拖过 TimeoutStartSec
# 整个启动作业会被判失败。
TimeoutStartSec=30
SuccessExitStatus=0 143
KillMode=control-group
LimitNOFILE=65535

Environment=HOME={HOME}
Environment=TMPDIR=/tmp
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mihomo

[Install]
WantedBy=multi-user.target
