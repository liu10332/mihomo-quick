#!/bin/bash
# mihomo-start - 启动 mihomo 并配置环境

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
source "$HOME/.mihomo-quick/lib/common.sh"
source "$HOME/.mihomo-quick/lib/detect.sh"
source "$HOME/.mihomo-quick/lib/service.sh"

# 检查是否已运行
if [[ -f "$PID_FILE" ]]; then
    PID=$(cat "$PID_FILE" 2>/dev/null)
    if [[ -n "$PID" ]] && kill -0 "$PID" 2>/dev/null; then
        log_warn "Mihomo 已在运行 (PID: $PID)"
        echo "   停止: mihomo-stop | 重启: mihomo-menu"
        exit 0
    else
        rm -f "$PID_FILE"
    fi
fi

# 检查配置文件
if [[ ! -f "${CONFIG_DIR}/config.yaml" ]]; then
    log_error "配置文件不存在: ${CONFIG_DIR}/config.yaml"
    echo "   请先创建配置或运行 install.sh"
    exit 1
fi

echo "🚀 启动 Mihomo..."
echo "   配置: $CONFIG_DIR/config.yaml"
echo "   日志: $LOG_FILE"
echo "   端口: 7890 (HTTP) / 7891 (SOCKS5)"
echo "   面板: http://127.0.0.1:9090/ui"

# 启动
start_manual
