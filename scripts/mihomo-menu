#!/bin/bash
# mihomo-menu - mihomo-quick 统一管理菜单

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
source "$SCRIPT_DIR/../lib/common.sh"
source "$SCRIPT_DIR/../lib/detect.sh"
source "$SCRIPT_DIR/../lib/service.sh"

# 服务状态
service_status() {
    local status
    status=$(get_service_status)
    case "$status" in
        running) echo -e "${GREEN}运行中${NC}" ;;
        *) echo -e "${YELLOW}未运行${NC}" ;;
    esac
}

# 版本信息
version_info() {
    if [[ -x "$MIHOMO_BIN" ]]; then
        "$MIHOMO_BIN" -v 2>/dev/null | head -1 || echo "未知版本"
    else
        echo -e "${RED}未安装${NC}"
    fi
}

# 显示菜单
show_menu() {
    clear 2>/dev/null
    echo -e "${CYAN}"
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║                  mihomo-quick 管理菜单                      ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
    echo -e "  版本: $(version_info) | 状态: $(service_status)"
    echo ""
    echo -e "  ${WHITE}服务管理${NC}"
    echo "   1) 🚀 启动服务 (普通模式)"
    echo "   2) 🚀 启动服务 (TUN 模式)"
    echo "   3) 🛑 停止服务"
    echo "   4) 🔄 重启服务"
    echo "   5) 📊 查看状态"
    echo ""
    echo -e "  ${WHITE}配置管理${NC}"
    echo "   6) 📦 添加订阅"
    echo "   7) 📜 管理规则"
    echo "   8) ✅ 校验配置"
    echo "   9) ⏪ 配置回滚"
    echo "  10) 📝 编辑配置"
    echo ""
    echo -e "  ${WHITE}维护${NC}"
    echo "  11) 📋 查看日志"
    echo "  12) 🔄 检查更新 (内核/面板/GeoIP)"
    echo "  13) 🔧 安装/更新服务 (开机自启)"
    echo "  14) 🧪 代理测试"
    echo ""
    echo -e "  ${WHITE}其他${NC}"
    echo "  15) 🗑️  卸载"
    echo "   0) 退出"
    echo ""
}

# 主循环
while true; do
    show_menu
    read -p "请选择 [0-15]: " choice
    echo ""

    case $choice in
        1)
            if [[ -x "$SCRIPT_DIR/mihomo-start" ]]; then
                "$SCRIPT_DIR/mihomo-start"
            else
                log_error "mihomo-start 脚本未找到"
            fi
            ;;
        2)
            echo "🚀 启动 TUN 模式..."
            if systemctl is-active --quiet "$SERVICE_NAME_TUN" 2>/dev/null; then
                log_warn "${SERVICE_NAME_TUN} 服务已在运行"
            else
                sudo systemctl start "$SERVICE_NAME_TUN" 2>/dev/null || {
                    log_warn "${SERVICE_NAME_TUN} 服务未安装，尝试通过 setup-service.sh tun 创建..."
                    if [[ -f "$SCRIPT_DIR/../setup-service.sh" ]]; then
                        bash "$SCRIPT_DIR/../setup-service.sh" tun
                    else
                        log_error "setup-service.sh 未找到"
                    fi
                }
            fi
            ;;
        3)
            if [[ -x "$SCRIPT_DIR/mihomo-stop" ]]; then
                "$SCRIPT_DIR/mihomo-stop"
            fi
            stop_service
            ;;
        4)
            restart_service
            ;;
        5)
            echo -e "${WHITE}=== mihomo 服务状态 ===${NC}"
            systemctl status "$SERVICE_NAME_MIHOMO" --no-pager -l 2>/dev/null || echo "  mihomo 服务未安装"
            echo ""
            echo -e "${WHITE}=== mihomo-tun 服务状态 ===${NC}"
            systemctl status "$SERVICE_NAME_TUN" --no-pager -l 2>/dev/null || echo "  mihomo-tun 服务未安装"
            echo ""
            if [[ -x "$MIHOMO_BIN" ]]; then
                echo -e "${WHITE}=== mihomo 版本 ===${NC}"
                "$MIHOMO_BIN" -v 2>/dev/null
            fi
            ;;
        6)
            if [[ -x "$SCRIPT_DIR/mihomo-add-sub" ]]; then
                "$SCRIPT_DIR/mihomo-add-sub"
            else
                log_error "mihomo-add-sub 脚本未找到"
            fi
            ;;
        7)
            if [[ -x "$SCRIPT_DIR/mihomo-rules" ]]; then
                "$SCRIPT_DIR/mihomo-rules"
            else
                log_error "mihomo-rules 脚本未找到"
            fi
            ;;
        8)
            if [[ -x "$SCRIPT_DIR/mihomo-check" ]]; then
                "$SCRIPT_DIR/mihomo-check"
            else
                log_error "mihomo-check 脚本未找到"
            fi
            ;;
        9)
            if [[ -x "$SCRIPT_DIR/mihomo-rollback" ]]; then
                "$SCRIPT_DIR/mihomo-rollback"
            else
                log_error "mihomo-rollback 脚本未找到"
            fi
            ;;
        10)
            ${EDITOR:-vi} "$CONFIG_DIR/config.yaml"
            log_info "配置文件已保存"
            log_warn "运行 '8) 校验配置' 确认无误后，'4) 重启服务' 生效"
            ;;
        11)
            if [[ -x "$SCRIPT_DIR/mihomo-logs" ]]; then
                "$SCRIPT_DIR/mihomo-logs"
            else
                journalctl -u "$SERVICE_NAME_MIHOMO" -u "$SERVICE_NAME_TUN" --no-pager -n 50
            fi
            ;;
        12)
            if [[ -x "$SCRIPT_DIR/mihomo-update" ]]; then
                "$SCRIPT_DIR/mihomo-update"
            else
                log_error "mihomo-update 脚本未找到"
            fi
            ;;
        13)
            SETUP="$SCRIPT_DIR/../setup-service.sh"
            if [[ -f "$SETUP" ]]; then
                echo -e "${WHITE}选择模式:${NC}"
                echo "  1) 普通模式 (HTTP/SOCKS5)"
                echo "  2) TUN 模式 (透明代理)"
                read -p "请选择 [1/2]: " mode
                case $mode in
                    2) bash "$SETUP" tun ;;
                    *) bash "$SETUP" ;;
                esac
            else
                log_error "setup-service.sh 未找到"
            fi
            ;;
        14)
            if [[ -x "$SCRIPT_DIR/test-all-proxy" ]]; then
                "$SCRIPT_DIR/test-all-proxy"
            else
                log_error "test-all-proxy 脚本未找到"
            fi
            ;;
        15)
            if [[ -x "$SCRIPT_DIR/uninstall.sh" ]]; then
                bash "$SCRIPT_DIR/uninstall.sh"
            else
                log_error "uninstall.sh 脚本未找到"
            fi
            ;;
        0|q|Q)
            echo -e "${GREEN}👋 再见${NC}"
            exit 0
            ;;
        *)
            log_error "无效选择，请输入 0-15"
            ;;
    esac

    echo ""
    read -p "按 Enter 返回菜单..." _
done
